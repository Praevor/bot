# discord app id
APPLICATION_ID=
# discord app token
DISCORD_TOKEN=
# secret for encrypting passwords
SECRET=
# auth key for ERLC public app (from https://api.erlc.gg/developers/applications)
AUTH=
# app id from https://api.erlc.gg/developers/applications
APP_ID=
# the db user and passsword for the docker db
DB_USER=
DB_PASSWORD=

# the push URL for uptime kuma (optional)
PUSH_URL=
# the push interval in MS for uptime kuma (required if PUSH_URL is set)
PUSH_INTERVAL=

# set to true if you want extra logs (optional)
DEBUG=
