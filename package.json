{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"lint": "prettier --check . && eslint --ext .ts --format=pretty src",
		"deploy": "node --env-file=.env dist/src/util/deploy.js",
		"deploy:noenv": "node dist/src/util/deploy.js",
		"format": "prettier --write . && eslint --ext .ts --fix --format=pretty src",
		"start": "tsc && node --env-file=.env dist/src/index.js",
		"start:nobuild": "node --env-file=.env dist/src/index.js",
		"prepare": "husky || true",
		"format:check": "prettier -c --ignore-unknown *"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@discordjs/core": "^2.3.0",
		"@erlcjs/core": "2.0.0-beta.1",
		"@erlcjs/map": "2.0.0-beta.1",
		"cryptr": "^6.4.0",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.9",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sapphire/ts-config": "^5.0.1",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.5",
		"eslint": "^9.37.0",
		"eslint-config-neon": "^0.5.4",
		"eslint-formatter-compact": "^9.0.1",
		"eslint-formatter-pretty": "^7.0.0",
		"globals": "^17.14.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.6.2",
		"tsx": "^4.23.15",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
